{
  "name": "patent-review-console",
  "version": "0.1.0",
  "private": true,
  "description": "Companion review console for hannahhkyme/ai-patent-analyzer.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "bash scripts/pw-docker.sh npx playwright test",
    "test:e2e:update": "bash scripts/pw-docker.sh npx playwright test --update-snapshots",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e:docker",
    "record": "node scripts/record-walkthrough.mjs",
    "record:docker": "bash scripts/pw-docker.sh node scripts/record-walkthrough.mjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^26.1.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=20.19"
  }
}
